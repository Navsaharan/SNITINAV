# Runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Required only when running prisma db seed or the legacy setup script
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# Required only for the legacy setup script; never commit a real connection string
SUPABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
